{
  "name": "listener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/app/bot.js",
    "dev": "tsx watch src/app/bot.ts",
    "config:check": "tsx src/cli/config-check.ts",
    "logs": "tsx src/cli/logs.ts",
    "faces:sync": "tsx src/cli/sync-faces.ts",
    "dashboard:dev": "tsx scripts/dashboard-dev.ts",
    "dashboard:typecheck": "vue-tsc --noEmit -p src/dashboard/web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "dashboard:build": "npm run dashboard:typecheck && npm run build && vite build --config src/dashboard/web/vite.config.ts",
    "dashboard:start": "node dist/dashboard/server/index.js",
    "dashboard:test": "tsx --test dashboard/tests/*.test.ts",
    "dashboard:test:browser": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "dotenv": "^17.2.3",
    "echarts": "^6.1.0",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "smol-toml": "^1.9.0",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
