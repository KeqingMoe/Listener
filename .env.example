# 本机 .env 已有 OneBot 密钥，不要用此文件覆盖。
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=replace-with-your-napcat-access-token

# 单群专用；入口会校验这两个值，工具还会独立校验。
ALLOWED_GROUP_IDS=100000002
ADMIN_USER_IDS=100000001
# Listener 无论此开关如何设置都不回复、不记忆私聊。
ALLOW_PRIVATE=false
ALLOWED_USER_IDS=

# 填好地址、模型和密钥后才开启。模型必须支持 tools/function calling。
AI_ENABLED=false
# 填 API 前缀（通常以 /v1 结尾），不要填 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
# 仅 HTTPS，或者本机 localhost/127.0.0.1 的 HTTP 服务。
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=1200
# 每轮触发后随机等待1～3秒，合并消息；@/引用优先于随机触发。
AI_DEBOUNCE_MS=1000
AI_DELAY_MAX_MS=3000
AI_COOLDOWN_MS=5000
# 普通消息触发AI决策的概率，0关闭，1为每条合格消息都抽中；不保证发言。
AI_RANDOM_REPLY_PROBABILITY=0.03
# 随机决策被接纳即占用额度，即使最终保持沉默；不会限制@/引用。
AI_RANDOM_COOLDOWN_MS=60000
AI_RANDOM_MAX_PER_MINUTE=2
AI_MEMORY_PATH=data/listener.sqlite
# 保守字符预算代替 tokenizer；模型上下文需容纳此预算及人设/工具/输出。
AI_CONTEXT_CHARS=24000
AI_RETENTION_DAYS=7

API_TIMEOUT_MS=10000
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000
HEARTBEAT_MS=30000
# 不自动重发超时消息或管理操作。随机触发永远不能申请管理操作。
